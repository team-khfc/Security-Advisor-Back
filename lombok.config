# Lombok 허용 목록 강제(AGENTS.md 5장 코딩 규칙, 2026-11-07).
# 허용: @Getter, @RequiredArgsConstructor, @NoArgsConstructor(access = PROTECTED), @Slf4j
# 아래 항목은 사용 시 컴파일 오류. 엔티티의 @Builder·@AllArgsConstructor·@EqualsAndHashCode·@ToString 은 리뷰로 확인한다.
config.stopBubbling = true
lombok.setter.flagUsage = error
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.val.flagUsage = error
lombok.var.flagUsage = error
# 생성 코드에 @Generated 를 붙여 커버리지·정적 분석에서 제외되게 한다.
lombok.addLombokGeneratedAnnotation = true
