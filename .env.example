# 로컬 개발용 환경변수 예시. `cp .env.example .env` 로 복사해서 쓴다. .env 는 커밋하지 않는다(.gitignore).
# 완성본(Security-Advisor 저장소)에서는 그쪽 .env.example 이 기준이다.

# 데이터베이스
# 로컬(IDE) 실행용 DB. docker compose 로 띄우면 app 컨테이너는 아래 POSTGRES_* 로 db 서비스에 붙는다
DB_URL=jdbc:postgresql://localhost:5432/boan
DB_USERNAME=boan
DB_PASSWORD=boan
POSTGRES_DB=boan
POSTGRES_USER=boan
POSTGRES_PASSWORD=boan
APP_PORT=8080

# 시연 계정(applicant, applicant2, security, infra, admin) 공통 비밀번호 — 시연용 기본값. 실제 업무 비밀번호를 쓰지 않는다.
# 비우면 시연 계정을 만들지 않는다.
DEMO_ACCOUNT_PASSWORD=Demo1234!

# 로그인 실패 제한
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=15m

# HTTPS 로 서비스할 때 true
SESSION_COOKIE_SECURE=false

# ---- 운영 기관 (설치당 1곳, 기관 테이블 없음) ----
INSTITUTION_NAME=합성 시연 기관
INSTITUTION_CODE=DEMO

# 업로드 파일 저장 폴더(컨테이너 안 경로, 볼륨 마운트 권장)
STORAGE_DIR=./storage

# ---- AI (F-03·F-10) ----
# live: llm_configurations 의 활성 구성으로 실제 호출 / fake: 네트워크 없이 고정 응답(오프라인 시연·테스트)
LLM_MODE=live
# 엔드포인트 호스트 허용 목록(쉼표). 여기 없는 host 는 구성 등록·호출 모두 거부
LLM_ALLOWED_HOSTS=api.openai.com,openrouter.ai,ollama,localhost,host.docker.internal
# 모델 관리 화면에서 선택할 수 있는 키 참조 이름만 허용한다. 사용자 지정 키는 이 목록에도 추가한다.
LLM_ALLOWED_KEY_ENVS=OPENAI_API_KEY,OPENROUTER_API_KEY,OLLAMA_API_KEY
# API 키는 환경변수로만. llm_configurations.api_key_env 가 가리키는 이름이다
OPENAI_API_KEY=
# Ollama 등 키가 필요 없는 OpenAI 호환 서버는 아무 값이나(비어 있으면 안 됨)
OLLAMA_API_KEY=ollama
# OpenRouter(OpenAI 호환): seed 구성 openrouter-deepseek-v4.1-flash-1017(priority 5)이 이 키를 쓴다 — 값을 넣으면 OpenAI·Ollama 보다 먼저 선택된다
OPENROUTER_API_KEY=

# 외부 알림 채널(선택, F-17). 비우면 화면 안 알림만. 메신저 수신 웹훅(Slack·Teams·카카오워크 incoming webhook, JSON {"text"})
NOTIFY_WEBHOOK_URL=
# 메일(기관 내부 릴레이 전제). SMTP_HOST 와 SMTP_FROM 이 있어야 켜진다. 수신 주소는 계정별(PUT /api/members/{username}/contact)
SMTP_HOST=
SMTP_PORT=587
# true: STARTTLS 필수 / false: 연결 시작부터 TLS(SMTPS, 일반적으로 465). 평문 메일은 지원하지 않는다.
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
